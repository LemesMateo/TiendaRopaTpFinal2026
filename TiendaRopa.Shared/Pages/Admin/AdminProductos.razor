@page "/admin/productos"
@using TiendaRopa.Contracts.Admin
@using TiendaRopa.Contracts.Catalogo
@using TiendaRopa.Shared.Models
@using TiendaRopa.Shared.Services
@inject IAdminService AdminApi
@inject SesionService Sesion
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Productos — Administración — Velvet Rose Boutique</PageTitle>

@* Gestión de productos y variantes (mockup 09_gestion_productos.png).
   Baja lógica para conservar historial; variantes sin duplicar
   producto+talle+color y sin stock negativo (también validado en backend). *@

@if (!sesionCargada)
{
    <LoadingState Text="Verificando tu sesión..." />
}
else if (!Sesion.EsAdministrador)
{
    <EmptyState Icon="admin_panel_settings"
                 Title="Sección restringida"
                 Description="Necesitás iniciar sesión con una cuenta administradora.">
        <AppButton Variant="primary" Icon="login" Href="/login?redirect=/admin/productos">
            Iniciar sesión
        </AppButton>
    </EmptyState>
}
else
{
    <header class="admin-head">
        <div>
            <h1>Productos</h1>
            <p class="page-sub">Alta, edición, variantes y baja lógica.</p>
        </div>
        <AppButton Variant="primary" Icon="add" OnClick="NuevoProducto">
            Nuevo producto
        </AppButton>
    </header>

    <div class="admin-toolbar">
        <SearchBar Value="@buscar"
                   ValueChanged="OnBuscar"
                   Placeholder="Buscar productos..."
                   Label="Buscar productos por nombre o categoría" />
        <label class="admin-filter">
            <span>Estado</span>
            <select @bind="filtroActivo" @bind:after="CargarAsync">
                <option value="">Todos</option>
                <option value="true">Activos</option>
                <option value="false">Inactivos</option>
            </select>
        </label>
    </div>

    @if (mensajeLista is not null)
    {
        <p class="admin-notice @(esErrorLista ? "is-error" : "")" role="alert">@mensajeLista</p>
    }

    @if (editando is not null)
    {
        <section class="admin-form" aria-labelledby="form-title">
            <h2 id="form-title">@(editando.Id == 0 ? "Nuevo producto" : $"Editar producto #{editando.Id}")</h2>

            <div class="admin-form__grid">
                <label class="admin-field admin-field--wide">
                    <span>Nombre *</span>
                    <input type="text" @bind="editando.Nombre" maxlength="200" />
                </label>

                <label class="admin-field">
                    <span>Categoría *</span>
                    <select @bind="editando.IdCategoria">
                        <option value="0">Seleccionar…</option>
                        @foreach (var categoria in categorias)
                        {
                            <option value="@categoria.Id">@categoria.Nombre</option>
                        }
                    </select>
                </label>

                <label class="admin-field">
                    <span>Precio base *</span>
                    <input type="number" min="0" step="0.01" @bind="editando.PrecioBase" />
                </label>

                <label class="admin-field admin-field--wide">
                    <span>Descripción</span>
                    <textarea rows="3" maxlength="2000" @bind="editando.Descripcion"></textarea>
                </label>

                <label class="admin-check">
                    <input type="checkbox" @bind="editando.Activo" />
                    <span>Producto activo (visible en el catálogo)</span>
                </label>
            </div>

            @* Imágenes: se administran debajo de la descripción y antes de las
               variantes y las acciones finales. El binding es explícito para
               poder descartar un aviso de imágenes que ya no corresponde. *@
            <AdminImagenesEditor Imagenes="imagenesProducto"
                                 ImagenesChanged="OnImagenesCambiadas"
                                 AvisoCambiado="OnAvisoImagenes" />

            @if (editando.Id != 0 && productoEditado is not null)
            {
                @* Acordeón de variantes: queda entre los datos del producto y
                   las acciones finales, para poder completarlo y guardar sin
                   volver al principio del formulario. *@
                <section class="admin-accordion @(variantesAbiertas ? "is-open" : null)">
                    <button type="button"
                            class="admin-accordion__header"
                            id="variantes-header"
                            aria-expanded="@(variantesAbiertas ? "true" : "false")"
                            aria-controls="variantes-panel"
                            @onclick="ToggleVariantes">
                        <span class="admin-accordion__titulo">
                            <AppIcon Icon="style" Size="20" />
                            <span>Variantes</span>
                        </span>
                        <span class="admin-accordion__meta">
                            <span class="admin-accordion__conteo">
                                @(productoEditado.Variantes.Count == 1
                                    ? "1 variante"
                                    : $"{productoEditado.Variantes.Count} variantes")
                            </span>
                            <AppIcon Icon="expand_more" Size="24" Class="admin-accordion__chevron" />
                        </span>
                        @* Ayuda de escritorio (sólo al pasar el cursor); el
                           nombre accesible del botón es "Variantes". *@
                        <span class="admin-accordion__tooltip" aria-hidden="true">Administrar variantes</span>
                    </button>

                    <div class="admin-accordion__panel"
                         id="variantes-panel"
                         role="region"
                         aria-labelledby="variantes-header">
                        <div class="admin-variants">
                            <h3 id="variants-title">Variantes (talle + color + stock + precio)</h3>

                            <ul class="admin-variants__list">
                                @foreach (var variante in productoEditado.Variantes)
                                {
                                    <li>
                                        <span class="admin-variants__swatch" style="--swatch: @(variante.CodigoHex ?? "#CBD5CF")"></span>
                                        <strong>@variante.Talle</strong> · @variante.Color
                                        <span class="admin-variants__stock @(variante.Stock == 0 ? "is-empty" : variante.Stock <= 3 ? "is-low" : "")">
                                            @($"stock {variante.Stock}")
                                        </span>
                                        <span class="admin-variants__price">
                                            @(variante.Precio is { } p
                                                ? Services.CatalogoPresentation.FormatearPrecio(p)
                                                : "c/ precio base")
                                        </span>
                                    </li>
                                }
                            </ul>
                            @if (productoEditado.Variantes.Count == 0)
                            {
                                <p class="admin-variants__empty">Este producto todavía no tiene variantes.</p>
                            }

                            <div class="admin-form__grid admin-variants__form">
                                <label class="admin-field">
                                    <span>Talle</span>
                                    <select @bind="nuevaVariante.IdTalle">
                                        <option value="0">Elegir…</option>
                                        @foreach (var talle in talles)
                                        {
                                            <option value="@talle.Id">@talle.Nombre</option>
                                        }
                                    </select>
                                </label>
                                <label class="admin-field">
                                    <span>Color</span>
                                    <select @bind="nuevaVariante.IdColor">
                                        <option value="0">Elegir…</option>
                                        @foreach (var color in colores)
                                        {
                                            <option value="@color.Id">@color.Nombre</option>
                                        }
                                    </select>
                                </label>
                                <label class="admin-field">
                                    <span>Stock</span>
                                    <input type="number" min="0" @bind="nuevaVariante.Stock" />
                                </label>
                                <label class="admin-field">
                                    <span>Precio (vacío = base)</span>
                                    <input type="number" min="0" step="0.01" @bind="nuevaVariante.Precio" />
                                </label>
                            </div>

                            <AppButton Variant="outline" Icon="add" Disabled="guardando" OnClick="GuardarVarianteAsync">
                                Guardar variante
                            </AppButton>

                            @if (mensajeVariante is not null)
                            {
                                <p class="admin-notice @(esErrorVariante ? "is-error" : "")"
                                   role="alert">@mensajeVariante</p>
                            }
                        </div>
                    </div>
                </section>
            }

            @* Aviso del formulario: vive DENTRO de la tarjeta, justo encima de
               Guardar/Cancelar, que es donde está mirando el usuario al intentar
               guardar. tabindex="-1" permite llevar el foco hasta el mensaje para
               que se anuncie y la pantalla se desplace hasta él. *@
            @if (mensajeForm is not null)
            {
                <p class="admin-notice admin-notice--form @(esErrorForm ? "is-error" : "")"
                   role="alert"
                   tabindex="-1"
                   @ref="avisoFormRef">@mensajeForm</p>
            }

            <div class="admin-form__actions">
                <AppButton Variant="primary" Icon="save" Disabled="guardando" OnClick="GuardarProductoAsync">
                    @(guardando ? "Guardando…" : "Guardar")
                </AppButton>
                <AppButton Variant="ghost" Icon="close" OnClick="CancelarEdicion">
                    Cancelar
                </AppButton>
            </div>
        </section>
    }

    @if (cargando)
    {
        <LoadingState Text="Cargando productos..." />
    }
    else if (productos.Count == 0)
    {
        <EmptyState Icon="inventory_2"
                    Title="Sin productos"
                    Description="No hay productos que coincidan con el filtro.">
        </EmptyState>
    }
    else
    {
        <ul class="admin-list">
            @foreach (var producto in productos)
            {
                <li class="admin-list__item @(producto.Activo ? "" : "is-inactive")">
                    <div class="admin-list__media">
                        @if (!string.IsNullOrWhiteSpace(producto.UrlImagen))
                        {
                            <img src="@producto.UrlImagen" alt="@producto.Nombre" />
                        }
                        else
                        {
                            <div class="admin-list__placeholder" aria-hidden="true">
                                <AppIcon Icon="checkroom" Size="22" />
                            </div>
                        }
                    </div>

                    <div class="admin-list__body">
                        <p class="admin-list__name">@producto.Nombre</p>
                        <p class="admin-list__meta">
                            @producto.Categoria ·
                            @(Services.CatalogoPresentation.FormatearPrecio(producto.PrecioBase)) ·
                            @producto.CantidadVariantes @(producto.CantidadVariantes == 1 ? "variante" : "variantes") ·
                            stock total @producto.StockTotal
                        </p>
                    </div>

                    <StatusBadge Text="@(producto.Activo ? "Activo" : "Inactivo")"
                                 Tone="@(producto.Activo ? "success" : "neutral")" />

                    <div class="admin-list__actions">
                        <AppButton Variant="outline" Size="sm" Icon="edit" OnClick="(() => Editar(producto))">
                            Editar
                        </AppButton>
                        @if (producto.Activo)
                        {
                            <AppButton Variant="ghost" Size="sm" Icon="archive" OnClick="(() => Desactivar(producto))">
                                Desactivar
                            </AppButton>
                        }
                    </div>
                </li>
            }
        </ul>
    }
}

@code {
    private bool sesionCargada;
    private bool cargando = true;
    private bool guardando;

    /// <summary>
    /// Aviso de la página (lista de productos). Nunca reemplaza al aviso del
    /// formulario: son estados distintos y así no aparece un error viejo
    /// arriba del formulario.
    /// </summary>
    private string? mensajeLista;
    private bool esErrorLista;

    /// <summary>Aviso del formulario de producto, justo encima de Guardar/Cancelar.</summary>
    private string? mensajeForm;
    private bool esErrorForm;

    /// <summary>Aviso del alta de variantes, dentro del acordeón.</summary>
    private string? mensajeVariante;
    private bool esErrorVariante;

    /// <summary>Referencia al aviso del formulario para llevarle el foco.</summary>
    private ElementReference avisoFormRef;

    /// <summary>True cuando hay que enfocar/enfocar de nuevo el aviso tras renderizar.</summary>
    private bool enfocarAviso;

    /// <summary>Estado del acordeón de variantes (arranca plegado).</summary>
    private bool variantesAbiertas;

    private string? buscar;
    private string filtroActivo = "";

    private List<ProductoAdminDto> productos = [];
    private List<EntidadCatalogoDto> categorias = [];
    private List<EntidadCatalogoDto> talles = [];
    private List<EntidadCatalogoDto> colores = [];

    private ProductoUpsertRequest? editando;
    /// <summary>Copia editable con variantes (se recarga tras cada alta/edición).</summary>
    private ProductoAdminDto? productoEditado;
    /// <summary>Imágenes en edición (las nuevas se suben al guardar el producto).</summary>
    private IReadOnlyList<ImagenProducto> imagenesProducto = [];
    private VarianteUpsertRequest nuevaVariante = new()
    {
        IdProducto = 0,
        IdTalle = 0,
        IdColor = 0,
        Stock = 1,
    };

    private CancellationTokenSource? busquedaCts;

    protected override void OnInitialized() => Sesion.Cambio += OnSesionCambiada;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Cuando aparece (o cambia) un aviso de error en el formulario, el foco
        // se lleva al mensaje: se anuncia por accesibilidad y el navegador/WebView
        // desplaza la vista hasta él, aunque el usuario esté al final del form.
        if (enfocarAviso)
        {
            enfocarAviso = false;

            try
            {
                await avisoFormRef.FocusAsync(preventScroll: false);
            }
            catch (Exception)
            {
                // El aviso puede haberse desmontado (cancelar/recargar): el
                // mensaje ya se muestra, sólo no se mueve el foco.
            }
        }

        if (!sesionCargada)
        {
            await Sesion.CargarAsync();
            sesionCargada = true;
            StateHasChanged();

            if (Sesion.EsAdministrador)
            {
                await CargarListasAsync();
                await CargarAsync();
            }
        }
    }

    private void OnSesionCambiada() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Despliega o repliega el acordeón de variantes. El panel permanece en el
    /// DOM (sólo cambia su visibilidad) para no perder lo ya cargado.
    /// </summary>
    private void ToggleVariantes() => variantesAbiertas = !variantesAbiertas;

    private async Task CargarListasAsync()
    {
        try
        {
            categorias = (await AdminApi.GetCategoriasAsync(activo: true)).ToList();
            talles = (await AdminApi.GetTallesAsync(activo: true)).ToList();
            colores = (await AdminApi.GetColoresAsync(activo: true)).ToList();
        }
        catch (Exception)
        {
            // Los selects quedan vacíos; el mensaje de error lo da CargarAsync.
        }
    }

    private async Task CargarAsync()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            bool? activo = filtroActivo switch
            {
                "true" => true,
                "false" => false,
                _ => null,
            };

            var resultado = await AdminApi.GetProductosAsync(buscar, activo, 1, 50);
            productos = resultado.Items.ToList();

            // Al recargar el listado se descarta el aviso de página: describía
            // el estado anterior (p. ej. un error ya resuelto).
            mensajeLista = productos.Count == 0 ? "No hay productos para ese filtro." : null;
            esErrorLista = false;
        }
        catch (Exception)
        {
            productos = [];
            mensajeLista = "No pudimos conectar con la tienda.";
            esErrorLista = true;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private Task OnBuscar(string valor)
    {
        buscar = valor;
        busquedaCts?.Cancel();
        busquedaCts?.Dispose();
        var cts = new CancellationTokenSource();
        busquedaCts = cts;
        return BuscarConRetardoAsync(cts.Token);
    }

    private async Task BuscarConRetardoAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(350, ct);
            await CargarAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void NuevoProducto()
    {
        productoEditado = null;
        editando = new ProductoUpsertRequest
        {
            Id = 0,
            Nombre = string.Empty,
            IdCategoria = categorias.FirstOrDefault()?.Id ?? 0,
            PrecioBase = 0,
            Activo = true,
        };
        imagenesProducto = [];
        LimpiarAvisosFormulario();
    }

    private void Editar(ProductoAdminDto producto)
    {
        productoEditado = producto;
        editando = new ProductoUpsertRequest
        {
            Id = producto.Id,
            Nombre = producto.Nombre,
            IdCategoria = producto.IdCategoria,
            Descripcion = producto.Descripcion,
            PrecioBase = producto.PrecioBase,
            Activo = producto.Activo,
        };
        // Se respeta el orden persistido (el que devuelve el servidor ordenado
        // por Orden): la principal se indica con su insignia, no moviéndola al
        // frente. Si se reordenara acá, guardar sin cambios alteraría el orden.
        imagenesProducto = producto.Imagenes
            .OrderBy(i => i.Orden)
            .Select(i => new ImagenProducto
            {
                Id = i.Id,
                Url = i.UrlImagen,
                EsNueva = false,
                Principal = i.Principal,
            })
            .ToList();
        nuevaVariante = new VarianteUpsertRequest
        {
            IdProducto = producto.Id,
            IdTalle = 0,
            IdColor = 0,
            Stock = 1,
        };
        LimpiarAvisosFormulario();
    }

    private void CancelarEdicion()
    {
        editando = null;
        productoEditado = null;
        imagenesProducto = [];
        LimpiarAvisosFormulario();
    }

    /// <summary>
    /// Borra los avisos del formulario (producto, imágenes y variantes). Se usa
    /// al abrir, cancelar o recargar un producto para no arrastrar mensajes de
    /// un estado que ya no corresponde.
    /// </summary>
    private void LimpiarAvisosFormulario()
    {
        mensajeForm = null;
        esErrorForm = false;
        mensajeVariante = null;
        esErrorVariante = false;
        enfocarAviso = false;
    }

    /// <summary>
    /// Recibe la lista de imágenes editada por <see cref="AdminImagenesEditor"/>.
    /// Al cambiar la lista se descarta el aviso de imágenes anterior: ya no
    /// describe el estado actual del formulario.
    /// </summary>
    private void OnImagenesCambiadas(IReadOnlyList<ImagenProducto> imagenes)
    {
        // El propio editor publica su aviso (o lo limpia) mediante
        // OnAvisoImagenes: aquí sólo se guarda la lista vigente.
        imagenesProducto = imagenes;
    }

    /// <summary>
    /// Recibe el aviso del editor de imágenes. Los errores de imágenes se
    /// muestran junto a Guardar/Cancelar (con la sección identificada en el
    /// texto) para que el usuario los vea aunque esté al final del formulario.
    /// </summary>
    private void OnAvisoImagenes((string? Texto, bool EsError) aviso)
    {
        if (aviso.Texto is null)
        {
            // Sólo se descarta el aviso de imágenes, nunca el del guardado.
            if (esErrorForm && mensajeForm?.StartsWith("Imágenes:", StringComparison.Ordinal) == true)
            {
                mensajeForm = null;
                esErrorForm = false;
            }

            return;
        }

        AvisarFormulario($"Imágenes: {aviso.Texto}", aviso.EsError);
    }

    /// <summary>
    /// Publica el aviso del formulario. Si es un error, pide el foco tras el
    /// render para que el mensaje se anuncie y la vista se desplace hasta él
    /// (el usuario suele estar al final del formulario).
    /// </summary>
    private void AvisarFormulario(string texto, bool error)
    {
        mensajeForm = texto;
        esErrorForm = error;

        // Sólo los errores mueven el foco: se anuncian y desplazan la vista.
        enfocarAviso = error;
    }

    private async Task GuardarProductoAsync()
    {
        if (editando is null || guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(editando.Nombre))
        {
            AvisarFormulario("Ingresá el nombre del producto.", error: true);
            return;
        }

        guardando = true;
        StateHasChanged();

        try
        {
            var guardado = await AdminApi.GuardarProductoAsync(editando);
            if (guardado is null)
            {
                AvisarFormulario(
                    AdminApi.UltimoError ?? "No se pudo guardar el producto.", error: true);
                return;
            }

            // Las imágenes se aplican ahora que el producto tiene Id. Se envía
            // la lista FINAL (lo que se conserva + lo que se agrega) en una sola
            // operación: el servidor borra lo que ya no está y valida el límite
            // sobre el resultado, así que quitar y agregar fotos no choca.
            if (!await GuardarImagenesAsync(guardado.Id))
            {
                return;
            }

            // Se recarga desde el servidor: el contador y las miniaturas pasan a
            // reflejar exactamente lo persistido en SQL Server.
            var actualizado = await AdminApi.GetProductoAsync(guardado.Id);
            Editar(actualizado ?? guardado);

            // La lista se refresca antes de publicar el éxito (CargarAsync
            // limpia el aviso de la página) para que el mensaje no se pierda.
            await CargarAsync();

            mensajeLista = $"Producto \"{guardado.Nombre}\" guardado con " +
                $"{imagenesProducto.Count} {(imagenesProducto.Count == 1 ? "imagen" : "imágenes")}.";
            esErrorLista = false;
        }
        catch (Exception)
        {
            AvisarFormulario("No pudimos conectar con la tienda.", error: true);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Aplica la lista FINAL de imágenes del producto en una sola operación
    /// atómica: bajas, altas y orden juntos.
    ///
    /// El conteo que se valida es el de <c>imagenesProducto</c> (lo que va a
    /// quedar), no el de las filas que todavía existen en la base. Por eso
    /// eliminar una imagen libera su lugar en el mismo guardado.
    /// Devuelve false si el servidor rechazó la operación.
    /// </summary>
    private async Task<bool> GuardarImagenesAsync(int productoId)
    {
        var lista = imagenesProducto.ToList();

        // Se conserva la principal elegida; si no hay ninguna marcada, la
        // primera de la lista asume ese rol (el servidor también lo garantiza).
        var indicePrincipal = lista.FindIndex(i => i.Principal);
        if (indicePrincipal < 0)
        {
            indicePrincipal = 0;
        }

        var finales = new List<ImagenFinalDto>(lista.Count);
        var nuevas = new List<ImagenNuevaDto>();

        for (var i = 0; i < lista.Count; i++)
        {
            var imagen = lista[i];

            if (!imagen.EsNueva)
            {
                finales.Add(new ImagenFinalDto
                {
                    Id = imagen.Id,
                    Principal = i == indicePrincipal,
                });
                continue;
            }

            if (imagen.Contenido is null)
            {
                AvisarFormulario(
                    "Una imagen nueva quedó sin contenido. Volvé a seleccionarla.", error: true);
                return false;
            }

            finales.Add(new ImagenFinalDto
            {
                Id = 0,
                IndiceNueva = nuevas.Count,
                Principal = i == indicePrincipal,
            });

            nuevas.Add(new ImagenNuevaDto
            {
                Contenido = imagen.Contenido,
                NombreArchivo = imagen.NombreArchivo ?? "imagen.jpg",
                ContentType = imagen.ContentType ?? "image/jpeg",
            });
        }

        var persistidas = await AdminApi.ReemplazarImagenesAsync(productoId, finales, nuevas);
        if (persistidas is null)
        {
            var detalle = AdminApi.UltimoError ?? "No se pudieron guardar las imágenes.";
            AvisarFormulario(detalle, error: true);
            return false;
        }

        // La lista local pasa a ser la devuelta por el servidor: los Id reales,
        // el orden definitivo y la principal quedan iguales a la base.
        imagenesProducto = persistidas
            .OrderBy(i => i.Orden)
            .Select(i => new ImagenProducto
            {
                Id = i.Id,
                Url = i.UrlImagen,
                EsNueva = false,
                Principal = i.Principal,
            })
            .ToList();

        return true;
    }

    private async Task GuardarVarianteAsync()
    {
        if (editando is null || guardando)
        {
            return;
        }

        if (nuevaVariante.IdTalle == 0 || nuevaVariante.IdColor == 0)
        {
            mensajeVariante = "Elegí talle y color para la variante.";
            esErrorVariante = true;
            return;
        }

        guardando = true;
        StateHasChanged();

        try
        {
            var variante = await AdminApi.GuardarVarianteAsync(new VarianteUpsertRequest
            {
                IdProducto = editando.Id,
                IdTalle = nuevaVariante.IdTalle,
                IdColor = nuevaVariante.IdColor,
                Stock = Math.Max(0, nuevaVariante.Stock),
                Precio = nuevaVariante.Precio,
            });

            if (variante is null)
            {
                // 409 de duplicado u otro rechazo de negocio.
                mensajeVariante = AdminApi.UltimoError ?? "No se pudo guardar la variante.";
                esErrorVariante = true;
                return;
            }

            mensajeVariante = $"Variante {variante.Talle} / {variante.Color} guardada.";
            esErrorVariante = false;
            nuevaVariante = new VarianteUpsertRequest
            {
                IdProducto = editando.Id,
                IdTalle = 0,
                IdColor = 0,
                Stock = 1,
            };
            await RecargarProductoAsync(editando.Id);
            await CargarAsync();
        }
        catch (Exception)
        {
            mensajeVariante = "No pudimos conectar con la tienda.";
            esErrorVariante = true;
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task RecargarProductoAsync(int id)
    {
        var producto = await AdminApi.GetProductoAsync(id);
        if (producto is not null)
        {
            Editar(producto);
        }
    }

    private async Task Desactivar(ProductoAdminDto producto)
    {
        guardando = true;
        StateHasChanged();

        try
        {
            var ok = await AdminApi.DesactivarProductoAsync(producto.Id);
            var error = AdminApi.UltimoError;

            if (ok)
            {
                if (editando?.Id == producto.Id)
                {
                    editando = null;
                    productoEditado = null;
                    imagenesProducto = [];
                }

                await CargarAsync();
            }

            // El aviso se publica después de recargar la lista (que lo limpia).
            mensajeLista = ok
                ? $"\"{producto.Nombre}\" se desactivó (baja lógica: conserva el historial)."
                : error ?? "No se pudo desactivar el producto.";
            esErrorLista = !ok;
        }
        catch (Exception)
        {
            mensajeLista = "No pudimos conectar con la tienda.";
            esErrorLista = true;
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Sesion.Cambio -= OnSesionCambiada;
        busquedaCts?.Cancel();
        busquedaCts?.Dispose();
    }
}
