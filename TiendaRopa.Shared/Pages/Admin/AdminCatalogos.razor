@page "/admin/catalogos"
@using TiendaRopa.Contracts.Admin
@using TiendaRopa.Shared.Services
@inject IAdminService AdminApi
@inject SesionService Sesion
@implements IDisposable

<PageTitle>Catálogos — Administración — Velvet Rose Boutique</PageTitle>

@* Altas, ediciones y desactivaciones de categorías, talles y colores.
   El backend aplica índices únicos (nombre) y rechaza duplicados. *@

@if (!sesionCargada)
{
    <LoadingState Text="Verificando tu sesión..." />
}
else if (!Sesion.EsAdministrador)
{
    <EmptyState Icon="admin_panel_settings"
                 Title="Sección restringida"
                 Description="Necesitás iniciar sesión con una cuenta administradora.">
        <AppButton Variant="primary" Icon="login" Href="/login?redirect=/admin/catalogos">
            Iniciar sesión
        </AppButton>
    </EmptyState>
}
else
{
    <header class="admin-head">
        <div>
            <h1>Categorías, talles y colores</h1>
            <p class="page-sub">Tablas de referencia del catálogo.</p>
        </div>
    </header>

    @if (mensaje is not null)
    {
        <p class="admin-notice @(esError ? "is-error" : "")" role="alert">@mensaje</p>
    }

    <div class="admin-catalogs">
        @foreach (var seccion in Secciones)
        {
            <section class="admin-form" aria-labelledby="sec-@seccion.Clave">
                <h2 id="sec-@seccion.Clave">@seccion.Titulo</h2>

                <div class="admin-form__grid">
                    <label class="admin-field admin-field--wide">
                        <span>Nombre</span>
                        <input type="text" @bind="seccion.NuevoNombre" maxlength="100" />
                    </label>
                    @if (seccion.Clave == "colores")
                    {
                        <label class="admin-field">
                            <span>Código HEX</span>
                            <input type="text" @bind="seccion.NuevoHex" maxlength="7" placeholder="#F3A6B6" />
                        </label>
                    }
                </div>

                <AppButton Variant="outline" Icon="add" Disabled="guardando"
                           OnClick="(() => GuardarAsync(seccion))">
                    Agregar
                </AppButton>

                <ul class="admin-variants__list">
                    @foreach (var item in seccion.Items)
                    {
                        <li class="@(item.Activo ? "" : "is-inactive")">
                            @if (seccion.Clave == "colores")
                            {
                                <span class="admin-variants__swatch" style="--swatch: @(item.CodigoHex ?? "#CBD5CF")"></span>
                            }
                            <strong>@item.Nombre</strong>
                            @if (seccion.Clave == "colores" && !string.IsNullOrWhiteSpace(item.CodigoHex))
                            {
                                <span class="admin-variants__price">@item.CodigoHex</span>
                            }
                            <span class="admin-variants__price">en uso: @item.EnUso</span>

                            <span class="admin-variants__stock @(!item.Activo ? "is-empty" : "")"
                                  style="margin-left:auto">
                                @(item.Activo ? "Activo" : "Inactivo")
                            </span>

                            <button type="button"
                                    class="mp-card__cancel"
                                    style="min-height:34px;font-size:0.75rem"
                                    disabled="@(!item.Activo)"
                                    @onclick="(() => DesactivarAsync(seccion, item))">
                                Desactivar
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
}

@code {
    private sealed class SeccionCatalogo
    {
        public required string Clave { get; init; }
        public required string Titulo { get; init; }
        public string NuevoNombre { get; set; } = string.Empty;
        public string? NuevoHex { get; set; }
        public List<EntidadCatalogoDto> Items { get; set; } = [];
    }

    private bool sesionCargada;
    private bool guardando;
    private string? mensaje;
    private bool esError;

    private List<SeccionCatalogo> Secciones { get; } =
    [
        new() { Clave = "categorias", Titulo = "Categorías" },
        new() { Clave = "talles", Titulo = "Talles" },
        new() { Clave = "colores", Titulo = "Colores" },
    ];

    protected override void OnInitialized() => Sesion.Cambio += OnSesionCambiada;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!sesionCargada)
        {
            await Sesion.CargarAsync();
            sesionCargada = true;
            StateHasChanged();

            if (Sesion.EsAdministrador)
            {
                await CargarAsync();
            }
        }
    }

    private void OnSesionCambiada() => InvokeAsync(StateHasChanged);

    private async Task CargarAsync()
    {
        try
        {
            Secciones[0].Items = (await AdminApi.GetCategoriasAsync(activo: null)).ToList();
            Secciones[1].Items = (await AdminApi.GetTallesAsync(activo: null)).ToList();
            Secciones[2].Items = (await AdminApi.GetColoresAsync(activo: null)).ToList();
            mensaje = null;
        }
        catch (Exception)
        {
            mensaje = "No pudimos conectar con la tienda.";
            esError = true;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task GuardarAsync(SeccionCatalogo seccion)
    {
        if (string.IsNullOrWhiteSpace(seccion.NuevoNombre))
        {
            mensaje = "Ingresá un nombre.";
            esError = true;
            return;
        }

        guardando = true;
        StateHasChanged();

        try
        {
            var request = new NombreActivoRequest
            {
                Nombre = seccion.NuevoNombre.Trim(),
                CodigoHex = seccion.Clave == "colores" ? seccion.NuevoHex?.Trim() : null,
                Activo = true,
            };

            var guardado = seccion.Clave switch
            {
                "categorias" => await AdminApi.GuardarCategoriaAsync(request),
                "talles" => await AdminApi.GuardarTalleAsync(request),
                _ => await AdminApi.GuardarColorAsync(request),
            };

            if (guardado is null)
            {
                mensaje = AdminApi.UltimoError ?? "No se pudo guardar (¿nombre duplicado?).";
                esError = true;
                return;
            }

            mensaje = $"\"{guardado.Nombre}\" guardado.";
            esError = false;
            seccion.NuevoNombre = string.Empty;
            seccion.NuevoHex = null;
            await CargarAsync();
        }
        catch (Exception)
        {
            mensaje = "No pudimos conectar con la tienda.";
            esError = true;
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task DesactivarAsync(SeccionCatalogo seccion, EntidadCatalogoDto item)
    {
        guardando = true;
        StateHasChanged();

        try
        {
            var ok = seccion.Clave switch
            {
                "categorias" => await AdminApi.DesactivarCategoriaAsync(item.Id),
                "talles" => await AdminApi.DesactivarTalleAsync(item.Id),
                _ => await AdminApi.DesactivarColorAsync(item.Id),
            };

            mensaje = ok
                ? $"\"{item.Nombre}\" se desactivó."
                : AdminApi.UltimoError ?? "No se pudo desactivar.";
            esError = !ok;
            await CargarAsync();
        }
        catch (Exception)
        {
            mensaje = "No pudimos conectar con la tienda.";
            esError = true;
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    public void Dispose() => Sesion.Cambio -= OnSesionCambiada;
}
