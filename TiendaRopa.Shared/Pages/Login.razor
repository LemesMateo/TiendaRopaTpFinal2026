@page "/login"
@using System.Text.RegularExpressions
@using TiendaRopa.Contracts.Identidad
@using TiendaRopa.Shared.Services
@inject IAuthService AuthApi
@inject SesionService Sesion
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión — Velvet Rose Boutique</PageTitle>

@* Login (mockup 01_login.png) conectado a la API con JWT. *@

<AuthPanel Title="Iniciar Sesión"
           Subtitle="Accedé para seguir tus compras."
           Notice="@notice"
           OnSubmit="Submit">
    <Fields>
        <FormField Label="Email"
                   Type="email"
                   Placeholder="tu@email.com"
                   AutoComplete="email"
                   @bind-Value="email"
                   Error="@GetError("email")" />

        <FormField Label="Contraseña"
                   Type="password"
                   Placeholder="Tu contraseña"
                   AutoComplete="current-password"
                   @bind-Value="password"
                   Error="@GetError("password")" />

        <div class="auth-forgot">
            <button type="button" class="auth-link" @onclick="RecoverPassword">
                ¿Olvidaste tu contraseña?
            </button>
        </div>
    </Fields>

    <Actions>
        <AppButton Variant="primary" FullWidth Icon="login" Type="submit" Disabled="enviando">
            @(enviando ? "Ingresando…" : "Iniciar Sesión")
        </AppButton>
    </Actions>

    <Footer>
        ¿No tenés cuenta? <a href="/registro" class="auth-link-inline">Crear cuenta</a>
    </Footer>
</AuthPanel>

@code {
    private string? email;
    private string? password;
    private string? notice;
    private bool enviando;
    private readonly Dictionary<string, string> errors = new();

    /// <summary>A dónde volver después del login (por ejemplo /carrito).</summary>
    [SupplyParameterFromQuery(Name = "redirect")]
    public string? Redirect { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Sesion.CargarAsync();
        if (Sesion.Iniciada)
        {
            NavegarTrasLogin();
        }
    }

    private string? GetError(string field)
        => errors.TryGetValue(field, out var message) ? message : null;

    private async Task Submit()
    {
        errors.Clear();
        notice = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            errors["email"] = "Ingresá tu email.";
        }
        else if (!Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            errors["email"] = "Ingresá un email válido, por ejemplo nombre@correo.com.";
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errors["password"] = "Ingresá tu contraseña.";
        }

        if (errors.Count > 0)
        {
            return;
        }

        enviando = true;
        StateHasChanged();

        try
        {
            var sesion = await AuthApi.LoginAsync(new LoginRequest
            {
                Email = email!.Trim(),
                Password = password!,
            });

            if (sesion is null)
            {
                notice = (AuthApi as HttpAuthService)?.UltimoError
                    ?? "Email o contraseña incorrectos.";
                return;
            }

            NavegarTrasLogin(sesion.Usuario.Rol);
        }
        catch (Exception)
        {
            notice = "No pudimos conectar con la tienda. Intentá nuevamente en unos segundos.";
        }
        finally
        {
            enviando = false;
        }
    }

    private void NavegarTrasLogin(string? rol = null)
    {
        // Sólo rutas internas: evita redireccionar a sitios externos.
        var destino = !string.IsNullOrWhiteSpace(Redirect) && Redirect.StartsWith('/')
            ? Redirect
            : (rol == "Administrador" ? "/admin" : "/");

        Navigation.NavigateTo(destino);
    }

    private void RecoverPassword()
    {
        notice = "La recuperación de contraseña estará disponible próximamente.";
    }
}
