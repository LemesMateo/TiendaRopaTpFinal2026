@* Marca Velvet Rose Boutique: rosa roja + hojas ciruela + logotipo.
   SVG en línea (sin recursos externos) para funcionar en MAUI sin conexión. *@
<span class="@CssClass">
    <svg class="vr-brand__mark" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
        <!-- Hojas (ciruela) -->
        <ellipse cx="16" cy="55" rx="11" ry="5.5" transform="rotate(-32 16 55)" fill="#5C2D69" />
        <ellipse cx="56" cy="55" rx="11" ry="5.5" transform="rotate(32 56 55)" fill="#713A7D" />
        <!-- Pétalos exteriores -->
        <g fill="#C51E3A">
            <ellipse cx="36" cy="19" rx="9.5" ry="12.5" />
            <ellipse cx="36" cy="19" rx="9.5" ry="12.5" transform="rotate(60 36 33)" />
            <ellipse cx="36" cy="19" rx="9.5" ry="12.5" transform="rotate(120 36 33)" />
            <ellipse cx="36" cy="19" rx="9.5" ry="12.5" transform="rotate(180 36 33)" />
            <ellipse cx="36" cy="19" rx="9.5" ry="12.5" transform="rotate(240 36 33)" />
            <ellipse cx="36" cy="19" rx="9.5" ry="12.5" transform="rotate(300 36 33)" />
        </g>
        <!-- Pétalos intermedios -->
        <g fill="#A81830">
            <ellipse cx="36" cy="24.5" rx="7" ry="9.5" transform="rotate(30 36 33)" />
            <ellipse cx="36" cy="24.5" rx="7" ry="9.5" transform="rotate(90 36 33)" />
            <ellipse cx="36" cy="24.5" rx="7" ry="9.5" transform="rotate(150 36 33)" />
            <ellipse cx="36" cy="24.5" rx="7" ry="9.5" transform="rotate(210 36 33)" />
            <ellipse cx="36" cy="24.5" rx="7" ry="9.5" transform="rotate(270 36 33)" />
            <ellipse cx="36" cy="24.5" rx="7" ry="9.5" transform="rotate(330 36 33)" />
        </g>
        <!-- Corazón de la rosa -->
        <circle cx="36" cy="33" r="7.5" fill="#8E0F2B" />
        <path d="M36 28.5a4.5 4.5 0 0 1 0 9 2.4 2.4 0 0 0 0-4.8 1.4 1.4 0 0 0 0 2.8"
              fill="none" stroke="#C51E3A" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <span class="vr-brand__text">
        <span class="vr-brand__name">Velvet Rose</span>
        <span class="vr-brand__tag">Boutique</span>
    </span>
</span>

@code {
    /// <summary>Clases CSS adicionales.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Tamaño aproximado del logotipo: sm | md | lg.</summary>
    [Parameter]
    public string Size { get; set; } = "md";

    private string CssClass => $"vr-brand vr-brand--{Size} {Class}".Trim();
}
