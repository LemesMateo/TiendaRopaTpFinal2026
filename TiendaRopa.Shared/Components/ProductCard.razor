<article class="vr-product-card">
    <div class="vr-product-card__media">
        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <img src="@ImageUrl" alt="@Name" loading="lazy" />
        }
        else
        {
            @* Sin foto aprobada todavía: marcador visual neutro (los activos
               fotográficos deben revisarse derechos antes de publicar). *@
            <div class="vr-product-card__placeholder" aria-hidden="true">
                <AppIcon Icon="checkroom" Size="44" />
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Badge))
        {
            <div class="vr-product-card__badge">
                <StatusBadge Text="@Badge" Tone="@BadgeTone" />
            </div>
        }

        <button type="button"
                class="vr-product-card__fav"
                disabled
                title="Favoritos: función pendiente de implementación"
                aria-label="@($"Favoritos de {Name}: función pendiente")">
            <AppIcon Icon="favorite" Size="20" />
        </button>
    </div>

    <div class="vr-product-card__body">
        @if (!string.IsNullOrWhiteSpace(Category))
        {
            <p class="vr-product-card__category">@Category</p>
        }
        <h3 class="vr-product-card__name">@Name</h3>
        <p class="vr-product-card__price">
            <span class="vr-product-card__price-now">@Price</span>
            @if (!string.IsNullOrWhiteSpace(OriginalPrice))
            {
                <s class="vr-product-card__price-was">@OriginalPrice</s>
            }
        </p>
        <div class="vr-product-card__cta">
            <AppButton Variant="primary"
                       Size="sm"
                       FullWidth
                       Icon="shopping_cart"
                       Disabled="!OnAdd.HasDelegate"
                       title="@(OnAdd.HasDelegate ? null : "Carrito pendiente de implementación")"
                       OnClick="HandleAdd">
                Agregar al carrito
            </AppButton>
        </div>
    </div>
</article>

@code {
    /// <summary>Nombre de la prenda.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Categoría (se muestra sobre el nombre si se informa).</summary>
    [Parameter]
    public string? Category { get; set; }

    /// <summary>Precio ya formateado, por ejemplo "$42.990".</summary>
    [Parameter, EditorRequired]
    public string Price { get; set; } = string.Empty;

    /// <summary>Precio anterior tachado (ofertas).</summary>
    [Parameter]
    public string? OriginalPrice { get; set; }

    /// <summary>Etiqueta destacada, por ejemplo "Nuevo" o "-20%".</summary>
    [Parameter]
    public string? Badge { get; set; }

    /// <summary>Tono de la etiqueta: primary | info | success | warning | danger.</summary>
    [Parameter]
    public string BadgeTone { get; set; } = "info";

    /// <summary>URL de la foto. Si es null se muestra un marcador visual.</summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>Se dispara al pulsar "Agregar al carrito".
    /// Sin delegado, el botón queda deshabilitado (carrito aún no existe).</summary>
    [Parameter]
    public EventCallback OnAdd { get; set; }

    private async Task HandleAdd()
    {
        if (OnAdd.HasDelegate)
        {
            await OnAdd.InvokeAsync();
        }
    }
}
