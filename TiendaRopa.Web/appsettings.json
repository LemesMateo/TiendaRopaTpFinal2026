{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    // La API se hospeda en este mismo sitio: la base del HttpClient es la raíz.
    // Si algún día se separa la API, acá va su URL absoluta
    // (o la variable de entorno Api__BaseUrl).
    "BaseUrl": "/"
  },
  "Asistente": {
    "Gemini": {
      // La API se hospeda en este sitio, pero la clave vive en los secretos de
      // TiendaRopa.Api: nunca en este archivo.
      "Modelo": "gemini-3.5-flash-lite",
      "MaxLlamadasPorTurno": 6,
      "MaxTokensSalida": 1024,
      "TimeoutSegundos": 90,
      "MaxTurnosHistorial": 10,
      "Temperatura": 0.4
    }
  }
}
