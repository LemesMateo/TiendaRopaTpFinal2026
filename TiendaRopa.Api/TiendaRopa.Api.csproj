<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TiendaRopa.Api</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Cuando la API se referencia desde TiendaRopa.Web (hospedaje en un solo
         sitio), los dos proyectos son Sdk.Web y el módulo de Hot Reload de
         Blazor se duplica, rompiendo el build en Debug. La API no aporta
         estáticos propios: sus imágenes se sirven desde wwwroot de la Web. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiendaRopa.Contracts\TiendaRopa.Contracts.csproj" />
  </ItemGroup>

  <!-- Cuando la API se referencia desde TiendaRopa.Web (hospedaje en un solo
       sitio), sus archivos no deben publicarse por duplicado: el sitio dueño
       del despliegue es la Web (su appsettings y su wwwroot mandan). -->
  <ItemGroup>
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.10" />

    <!-- Asistente conversacional con Gemini (Function Calling). -->
    <PackageReference Include="Google.GenAI" Version="2.1.0" />

    <!-- Google.Apis.Auth (transitivo de Google.GenAI) arrastra Pkcs 9.0.11,
         con vulnerabilidades conocidas (GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7,
         parcheadas en 9.0.21). Se fija la versión parcheada. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <!-- Los secretos de usuario de la API (Asistente:Gemini:ApiKey) viven fuera
       del repositorio. El identificador permite usar 'dotnet user-secrets'
       sin que la clave entre en appsettings.json ni en el control de versiones. -->
  <PropertyGroup>
    <UserSecretsId>velvetrose-api-3f7c1d92</UserSecretsId>
  </PropertyGroup>

</Project>
