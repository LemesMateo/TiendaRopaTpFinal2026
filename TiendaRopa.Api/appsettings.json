{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Asistente": {
    "Gemini": {
      // Modelo del asistente. Para usar gemini-3.8-flash basta cambiar esta
      // línea: la arquitectura no cambia.
      "Modelo": "gemini-3.5-flash-lite",
      // Límites por turno (protegen la cuota del nivel gratuito).
      "MaxLlamadasPorTurno": 6,
      "MaxTokensSalida": 1024,
      "TimeoutSegundos": 90,
      "MaxTurnosHistorial": 10,
      "Temperatura": 0.4
      // La API key NO va acá: se configura en los secretos de usuario de
      // TiendaRopa.Api (dotnet user-secrets set "Asistente:Gemini:ApiKey" ...)
      // o con la variable de entorno Asistente__Gemini__ApiKey.
    }
  }
}
