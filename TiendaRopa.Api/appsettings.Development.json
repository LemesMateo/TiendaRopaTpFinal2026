{
  "ConnectionStrings": {
    // LocalDB de desarrollo: autenticación integrada de Windows, sin secretos.
    // Entornos reales usan la variable ConnectionStrings__VelvetRose o user-secrets.
    "VelvetRose": "Server=(localdb)\\MSSQLLocalDB;Database=VelvetRoseDev;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
